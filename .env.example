# Application
APP_NAME=Documents ETL API
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false

# Vector store
VECTOR_STORE_BACKEND=simple

# Embeddings and chunking
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=50
DEFAULT_TOP_K=5

# Ingestion limits
MAX_FILE_SIZE_MB=50
URL_FETCH_TIMEOUT_SECONDS=30
