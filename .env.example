# This file is read by doc_etl_api.config. Which file is read is decided by
# DOC_ETL_API_ENV_FILE, taken from the process environment before this file is
# loaded -- so it cannot be set here. An empty value disables this file
# entirely, which is what the test suite does, so a test session sees the code
# defaults rather than whichever .env the developer has. Leave it unset to run
# the service. Documented in the README configuration table.

# Application
APP_NAME=Documents ETL API
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
# Search timings and bootstrap progress are logged at INFO.
LOG_LEVEL=INFO

# Vector store
# `simple` keeps the index in this process; `postgres` keeps it in a database, so
# it survives a restart. See "Vector store backends" in the README.
VECTOR_STORE_BACKEND=simple
# Read only when the backend above is `postgres`, and shown commented because the
# default backend does not use them. Four are then required together -- leaving
# one out stops the service at startup, naming it. `docker compose --profile
# postgres up` reads this file too: it gives the container POSTGRES_DATABASE,
# POSTGRES_USER and POSTGRES_PASSWORD, and publishes the container on
# POSTGRES_PORT, which is the port the service connects to. Unset, compose uses
# its own defaults, which are the values shown.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=doc_etl_api
# POSTGRES_USER=doc_etl_api
# POSTGRES_PASSWORD=doc_etl_api
# The store's tables are named after this one, so it is a lowercase SQL
# identifier rather than free text.
# POSTGRES_TABLE_NAME=doc_etl_api_index


# Embeddings and chunking
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE defaults to the embedding model's input limit (256 for this model),
# so it tracks the model instead of going stale against it. Set it only to go
# smaller; a value above the limit is rejected at startup rather than truncated.
CHUNK_OVERLAP=50
# Nodes smaller than this are merged into a neighbour rather than indexed alone,
# never past the embedding model's input limit. 0 indexes every node the splitter
# produces. The default follows the measured noise floor: 9-14 token scraps that
# outranked real passages in the corpus this was tuned on.
MIN_CHUNK_TOKENS=32
DEFAULT_TOP_K=5

# Ingestion limits
MAX_FILE_SIZE_MB=50
URL_FETCH_TIMEOUT_SECONDS=30
# Comma-separated languages a scanned PDF is read in. Vietnamese by default: a
# recogniser that does not know the language's diacritics substitutes others
# rather than dropping them, and in Vietnamese the diacritics are the word. Only
# pages with no text layer are read this way. Naming no language is rejected at
# startup, since an empty list means the OCR engine's own European default.
PDF_OCR_LANGUAGES=vi
