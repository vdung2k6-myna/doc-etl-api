# Common binary document formats processed by the ETL pipeline.
# Only ignore these at the repository root if you DO want to commit sample docs,
# replace with targeted patterns such as uploads/*.pdf or data/*.docx.
*.pdf
*.docx
*.doc
*.xlsx
*.pptx

# Temporary processing directories and files
tmp/
temp/
*.tmp

# Docker / local vector store volumes
qdrant_storage/

.claude*

# Planning artifacts live in the team-plans store, not in this repo. Only the
# store pointer is tracked, so a fresh clone resolves to the same specs.
# (`openspec*` would exclude this directory itself, and git cannot re-include
# a file whose parent directory is excluded — hence `openspec/*` + a negation.)
openspec/*
!openspec/config.yaml